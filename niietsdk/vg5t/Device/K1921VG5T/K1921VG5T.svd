                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <!--ADC-->
    <peripheral>
      <name>ADC</name>
      <version>1.0</version>
      <description>ADC control registers</description>
      <groupName>ADC</groupName>
      <baseAddress>0x40020000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x694</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ADC_SEQ0</name>
        <description>ADC Sequencer 0 interrupt</description>
        <value>60</value>
      </interrupt>
      <interrupt>
        <name>ADC_SEQ1</name>
        <description>ADC Sequencer 1 interrupt</description>
        <value>61</value>
      </interrupt>
      <interrupt>
        <name>ADC_DC0</name>
