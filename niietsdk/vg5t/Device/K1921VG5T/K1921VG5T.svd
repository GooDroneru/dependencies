  <!-- name of part -->
  <series>K1921VKx</series>
  <!-- device series the device belongs to -->
  <version>1.1</version>
  <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
  <description>Motor control MCU (core RISC-V SCR4)</description>
