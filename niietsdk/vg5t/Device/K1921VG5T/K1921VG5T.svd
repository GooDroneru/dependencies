    <!--SPI0-->
    <peripheral>
      <name>SPI0</name>
      <version>1.0</version>
      <description>SPI control registers</description>
      <groupName>SPI</groupName>
      <baseAddress>0x5000F000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x28</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI0</name>
        <description>SPI0 interrupt</description>
        <value>66</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RX</name>
        <description>SPI0 Receive interrupt</description>
        <value>67</value>
      </interrupt>
      <interrupt>
        <name>SPI0_TX</name>
        <description>SPI0 Transmit interrupt</description>
        <value>68</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RO</name>
        <description>SPI0 Receive Overrun interrupt</description>
        <value>69</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RT</name>
        <description>SPI0 Receive Timeout interrupt</description>
        <value>70</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CR: Control register -->
        <register>
          <name>CR</name>
          <description>Control register </description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x44000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TXIFLSEL: Transmit interrupt FIFO level select-->
            <field>
