      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x110</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>FLASH</name>
        <description>FLASH interrupt</description>
        <value>4</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--ADDR: Address Register-->
        <register>
          <name>ADDR</name>
          <description>Address Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BANK: Address value for flash operations (Bank number)-->
            <field>
              <name>BANK</name>
              <description>Address value for flash operations (Bank number)</description>
              <bitRange>[21:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value to selected flash IP</description>
              <bitRange>[17:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVR_ADDR: Address Register for NVR access-->
        <register>
          <name>NVR_ADDR</name>
          <description>Address Register for NVR access</description>
          <alternateRegister>ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HIGH_SECTOR: Sector address value (msb) to selected flash IP-->
            <field>
              <name>HIGH_SECTOR</name>
              <description>Sector address value (msb) to selected flash IP</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <!--SECTOR_ADDR: Sector address value (lsb) to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value (lsb) to selected flash IP</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector to selected flash IP-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector to selected flash IP</description>
              <bitRange>[10:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BYTESEL: Address value for each byte-->
            <field>
              <name>BYTESEL</name>
              <description>Address value for each byte</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>DATA[%s]</name>
          <description>DATA</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name />
            <description>Data Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xffffffff</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Data register value for flash operations-->
              <field>
                <name>VAL</name>
                <description>Data register value for flash operations</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--CMD: Command Register-->
        <register>
          <name>CMD</name>
          <description>Command Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xc0de0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: Magic Key for flash access "C0DE"-->
            <field>
              <name>KEY</name>
              <description>Magic Key for flash access "C0DE"</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Access</name>
                  <description>magic Key for flash access</description>
                  <value>49374</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--NVRON: NVR access bit-->
            <field>
              <name>NVRON</name>
              <description>NVR access bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--DPD: Enter/Exit power down mode-->
            <field>
              <name>DPD</name>
              <description>Enter/Exit power down mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ALLSEC: Select all sectors for erase-->
            <field>
              <name>ALLSEC</name>
              <description>Select all sectors for erase</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERSEC: Erase sector enable command-->
            <field>
              <name>ERSEC</name>
              <description>Erase sector enable command</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--WR: Write enable command-->
            <field>
              <name>WR</name>
              <description>Write enable command</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RD: Read enable command-->
            <field>
              <name>RD</name>
              <description>Read enable command</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STAT: Status Register-->
        <register>
          <name>STAT</name>
          <description>Status Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DPD: Flash IP in powerdown mode-->
            <field>
              <name>DPD</name>
              <description>Flash IP in powerdown mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--IRQF: IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.-->
            <field>
              <name>IRQF</name>
              <description>IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--BUSY: Busy status bit when command is processing-->
            <field>
              <name>BUSY</name>
              <description>Busy status bit when command is processing</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Control Register-->
        <register>
          <name>CTRL</name>
          <description>Control Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x10000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LAT: Flash latency-->
            <field>
              <name>LAT</name>
              <description>Flash latency</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CFLUSH: Flush internal buffer-->
            <field>
              <name>CFLUSH</name>
              <description>Flush internal buffer</description>
              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--IRQEN: Command Interrupt enable bit-->
            <field>
              <name>IRQEN</name>
              <description>Command Interrupt enable bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBEN: Fetch buffer Enable-->
            <field>
              <name>FBEN</name>
              <description>Fetch buffer Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCETR: Flash Timing Control register (Erase time)-->
        <register>
          <name>FTCETR</name>
          <description>Flash Timing Control register (Erase time)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xea60</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TSCE: Erase time value in cycles-->
            <field>
              <name>TSCE</name>
              <description>Erase time value in cycles</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRT: Flash Timing Control register (Program time)-->
        <register>
          <name>FTCPRT</name>
          <description>Flash Timing Control register (Program time)</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4820103c</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TPROG: Program time value in cycles-->
            <field>
              <name>TPROG</name>
              <description>Program time value in cycles</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPGS: PREPG to PROG2 time value in cycles-->
            <field>
              <name>TPREPGS</name>
              <description>PREPG to PROG2 time value in cycles</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPROG: Pre-program time value in cycles-->
            <field>
              <name>TPREPROG</name>
              <description>Pre-program time value in cycles</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPGS: Web to PROG2 high time value in cycles-->
            <field>
              <name>TPGS</name>
              <description>Web to PROG2 high time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCERTR: Flash Timing Control register (Erase Recovery time)-->
        <register>
          <name>FTCERTR</name>
          <description>Flash Timing Control register (Erase Recovery time)</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x32000c8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVCHIP: Chip erase recovery time value in cycles-->
            <field>
              <name>TRCVCHIP</name>
              <description>Chip erase recovery time value in cycles</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRCVSECT: Sector erase recovery time value in cycles-->
            <field>
              <name>TRCVSECT</name>
              <description>Sector erase recovery time value in cycles</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRTR: Flash Timing Control register (Program Recovery time)-->
        <register>
          <name>FTCPRTR</name>
          <description>Flash Timing Control register (Program Recovery time)</description>
          <addressOffset>0x10c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x14</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVPROG: Program recovery time value in cycles-->
            <field>
              <name>TRCVPROG</name>
              <description>Program recovery time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--SIU-->
    <peripheral>
      <name>SIU</name>
      <version>1.0</version>
      <description>System integration unit</description>
      <groupName>SIU</groupName>
      <baseAddress>0x50003000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x54</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--CHIPID: Chip identifier-->
        <register>
          <name>CHIPID</name>
          <description>Chip identifier</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ID: Model ID-->
            <field>
              <name>ID</name>
              <description>Model ID</description>
              <bitRange>[31:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--REV: Revision number-->
            <field>
              <name>REV</name>
              <description>Revision number</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--SERVCTL: Service mode Register-->
        <register>
          <name>SERVCTL</name>
          <description>Service mode Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SERVCMD: Service mode erase comand/status-->
            <field>
              <name>SERVCMD</name>
              <description>Service mode erase comand/status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SERVSTAT: Service mode status-->
            <field>
              <name>SERVSTAT</name>
              <description>Service mode status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--SYNC: Sync PWM/CAP register-->
        <register>
          <name>SYNC</name>
          <description>Sync PWM/CAP register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--PWMSYNCSEL2: PWM sync scheme control-->
            <field>
              <name>PWMSYNCSEL2</name>
              <description>PWM sync scheme control</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <!--PWMSYNCSEL1: PWM sync scheme control-->
            <field>
              <name>PWMSYNCSEL1</name>
              <description>PWM sync scheme control</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPSYNCSEL2: CAP sync scheme control-->
            <field>
              <name>CAPSYNCSEL2</name>
              <description>CAP sync scheme control</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPSYNCSEL1: CAP sync scheme control-->
            <field>
              <name>CAPSYNCSEL1</name>
              <description>CAP sync scheme control</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SWSYNC: SYNCI pulse software emulation  on PWM0-->
            <field>
              <name>SWSYNC</name>
              <description>SYNCI pulse software emulation  on PWM0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CNTEN: PWM/TMR count enable register enable register-->
        <register>
          <name>CNTEN</name>
          <description>PWM/TMR count enable register enable register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TMR3EN: Enable count for timer 3-->
            <field>
              <name>TMR3EN</name>
              <description>Enable count for timer 3</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <!--TMR2EN: Enable count for timer 2-->
            <field>
              <name>TMR2EN</name>
              <description>Enable count for timer 2</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--TMR1EN: Enable count for TMR 1-->
            <field>
              <name>TMR1EN</name>
              <description>Enable count for TMR 1</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <!--TMR0EN: Enable count for TMR 0-->
            <field>
              <name>TMR0EN</name>
              <description>Enable count for TMR 0</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--PWM2EN: Enable count for PWM 2-->
            <field>
              <name>PWM2EN</name>
              <description>Enable count for PWM 2</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--PWM1EN: Enable count for PWM 1-->
            <field>
              <name>PWM1EN</name>
              <description>Enable count for PWM 1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--PWM0EN: Enable count for PWM 0-->
            <field>
              <name>PWM0EN</name>
              <description>Enable count for PWM 0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TMRCFG: TMR external clock config-->
        <register>
          <name>TMRCFG</name>
          <description>TMR external clock config</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TMR3CLKMUX: Select ecternal clock source-->
            <field>
              <name>TMR3CLKMUX</name>
              <description>Select ecternal clock source</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR2CLKMUX: Select ecternal clock source-->
            <field>
              <name>TMR2CLKMUX</name>
              <description>Select ecternal clock source</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR1CLKMUX: Select ecternal clock source-->
            <field>
              <name>TMR1CLKMUX</name>
              <description>Select ecternal clock source</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR0CLKMUX: Select ecternal clock source-->
            <field>
              <name>TMR0CLKMUX</name>
              <description>Select ecternal clock source</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--CAPMUX: CAP input mux control register-->
        <register>
          <name>CAPMUX</name>
          <description>CAP input mux control register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CAPINSEL2: Select input source for CAP2-->
            <field>
              <name>CAPINSEL2</name>
              <description>Select input source for CAP2</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAP2</name>
                  <description>default CAP2 input</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPA</name>
                  <description>QEP A input</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPB</name>
                  <description>QEP B input</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPI</name>
                  <description>QEP I input</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CAPINSEL1: Select input source for CAP1-->
            <field>
              <name>CAPINSEL1</name>
              <description>Select input source for CAP1</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAP1</name>
                  <description>default CAP1 input</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPA</name>
                  <description>QEP A input</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPB</name>
                  <description>QEP B input</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPI</name>
                  <description>QEP I input</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CAPINSEL0: Select input source for CAP0-->
            <field>
              <name>CAPINSEL0</name>
              <description>Select input source for CAP0</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAP0</name>
                  <description>default CAP0 input</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPA</name>
                  <description>QEP A input</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPB</name>
                  <description>QEP B input</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>QEPI</name>
                  <description>QEP I input</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--QUALCTL: QEP and ECAP qualifier control register-->
        <register>
          <name>QUALCTL</name>
          <description>QEP and ECAP qualifier control register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--QEPMODE: Select mode of qualifier for QEP0-->
            <field>
              <name>QEPMODE</name>
              <description>Select mode of qualifier for QEP0</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--QEPEN: Enable qualifier for QEP0-->
            <field>
              <name>QEPEN</name>
              <description>Enable qualifier for QEP0</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPMODE2: Select mode of qualifier for CAP2-->
            <field>
              <name>CAPMODE2</name>
              <description>Select mode of qualifier for CAP2</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPMODE1: Select mode of qualifier for CAP1-->
            <field>
              <name>CAPMODE1</name>
              <description>Select mode of qualifier for CAP1</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPMODE0: Select mode of qualifier for CAP0-->
            <field>
              <name>CAPMODE0</name>
              <description>Select mode of qualifier for CAP0</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPEN2: Enable qualifier for CAP2-->
            <field>
              <name>CAPEN2</name>
              <description>Enable qualifier for CAP2</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPEN1: Enable qualifier for CAP1-->
            <field>
              <name>CAPEN1</name>
              <description>Enable qualifier for CAP1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPEN0: Enable qualifier for CAP0-->
            <field>
              <name>CAPEN0</name>
              <description>Enable qualifier for CAP0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--QUALSAMPLE: QEP and CAP qualifier sample period set register-->
        <register>
          <name>QUALSAMPLE</name>
          <description>QEP and CAP qualifier sample period set register</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--QEPVAL: Set sample period of qualifer for all QEPs-->
            <field>
              <name>QEPVAL</name>
              <description>Set sample period of qualifer for all QEPs</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CAPVAL: Set sample period of qualifer for all CAPs-->
            <field>
              <name>CAPVAL</name>
              <description>Set sample period of qualifer for all CAPs</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RCCTRL: RC generator control register-->
        <register>
          <name>RCCTRL</name>
          <description>RC generator control register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x142</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EN: Internal oscillator enable-->
            <field>
              <name>EN</name>
              <description>Internal oscillator enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--TUNE: Tune RC generator period-->
            <field>
              <name>TUNE</name>
              <description>Tune RC generator period</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--LDOCTRL: LDO control register-->
        <register>
          <name>LDOCTRL</name>
          <description>LDO control register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DISOSC: Disable 100kHz oscillator-->
            <field>
              <name>DISOSC</name>
              <description>Disable 100kHz oscillator</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ENABLEOSC</name>
                  <description>Enable 100kHz oscillator</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DISABLEOSC</name>
                  <description>Disable 100kHz oscillator</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TUNE: Tune LDO output voltage-->
            <field>
              <name>TUNE</name>
              <description>Tune LDO output voltage</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CPESTAT: CPE status register-->
        <register>
          <name>CPESTAT</name>
          <description>CPE status register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CPE: CPE status-->
            <field>
