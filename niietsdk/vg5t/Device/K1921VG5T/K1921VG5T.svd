          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DIVN: Divider coefficient-->
            <field>
              <name>DIVN</name>
              <description>Divider coefficient</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--DIVEN: Enable divider-->
            <field>
              <name>DIVEN</name>
              <description>Enable divider</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKSEL: Clock source select-->
            <field>
              <name>CLKSEL</name>
              <description>Clock source select</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HSICLK</name>
                  <description>HSI 4MHz</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSECLK</name>
                  <description>HSE(XTAL)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CLKEN: Clock enable-->
            <field>
              <name>CLKEN</name>
              <description>Clock enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RTCCFG: RTC APB clock divider-->
        <register>
          <name>RTCCFG</name>
          <description>RTC APB clock divider</description>
          <addressOffset>0xa0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x11000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DIVN: Divider coefficient-->
            <field>
              <name>DIVN</name>
              <description>Divider coefficient</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--DIVEN: Enable divider-->
            <field>
              <name>DIVEN</name>
              <description>Enable divider</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--RST: Reset active High-->
            <field>
              <name>RST</name>
              <description>Reset active High</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--BORCFG: BOR Configuration Register-->
        <register>
          <name>BORCFG</name>
          <description>BOR Configuration Register</description>
          <addressOffset>0xa4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TUNE: Tune BOR level-->
            <field>
              <name>TUNE</name>
              <description>Tune BOR level</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--EN: Enable BOR-->
            <field>
              <name>EN</name>
              <description>Enable BOR</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--HSECFG: HSE Configuration Register-->
        <register>
          <name>HSECFG</name>
          <description>HSE Configuration Register</description>
          <addressOffset>0xa8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DS: Drive current select pins-->
            <field>
              <name>DS</name>
              <description>Drive current select pins</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--EN: Enable HSE pins-->
            <field>
              <name>EN</name>
              <description>Enable HSE pins</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--INTEN: Interrupt enable reigster-->
        <register>
          <name>INTEN</name>
          <description>Interrupt enable reigster</description>
          <addressOffset>0xc0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CLKERR3: -->
            <field>
              <name>CLKERR3</name>
