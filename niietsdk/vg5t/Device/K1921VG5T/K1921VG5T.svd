      </addressBlock>
      <interrupt>
        <name>UART0</name>
        <description>UART0 interrupt</description>
        <value>76</value>
      </interrupt>
      <interrupt>
        <name>UART0_TD</name>
        <description>UART0 Transmit Done interrupt</description>
        <value>77</value>
      </interrupt>
      <interrupt>
        <name>UART0_RX</name>
        <description>UART0 Recieve interrupt</description>
        <value>78</value>
      </interrupt>
      <interrupt>
        <name>UART0_TX</name>
        <description>UART0 Transmit interrupt</description>
        <value>79</value>
      </interrupt>
      <interrupt>
