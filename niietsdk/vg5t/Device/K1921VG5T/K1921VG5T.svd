    <!--RTC-->
    <peripheral>
      <name>RTC</name>
      <version>1.0</version>
      <description>RTC control registers</description>
      <groupName>RTC</groupName>
      <baseAddress>0x50005000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x60</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>RTC</name>
        <description>Real-Time Clock interrupt</description>
        <value>3</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM1</name>
        <description>RTC_ALARM1 interrupt</description>
        <value>97</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM2</name>
        <description>RTC_ALARM2 interrupt</description>
        <value>98</value>
      </interrupt>
      <interrupt>
        <name>RTC_BAT</name>
        <description>RTC_BAT interrupt</description>
        <value>99</value>
      </interrupt>
      <interrupt>
        <name>RTC_POWEROK</name>
        <description>RTC_POWEROK interrupt</description>
        <value>100</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--TIME: Time register-->
        <register>
          <name>TIME</name>
          <description>Time register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM1: Alarm 1 register-->
        <register>
          <name>ALARM1</name>
          <description>Alarm 1 register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM2: Alarm 2 register-->
        <register>
          <name>ALARM2</name>
          <description>Alarm 2 register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: Control register-->
        <register>
          <name>CONTROL</name>
          <description>Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--FCM: Use 32 kHz clock to time register increment-->
            <field>
              <name>FCM</name>
              <description>Use 32 kHz clock to time register increment</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE</name>
                  <description>The time register is incremented each second</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAST_MODE</name>
                  <description>32 kHz clock is used to increment the time register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DRC: Disable RC oscillator-->
            <field>
              <name>DRC</name>
              <description>Disable RC oscillator</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--OIE: Timer overflow interrupt enable-->
            <field>
              <name>OIE</name>
              <description>Timer overflow interrupt enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPIE: Switch to normal power supply interrupt enable-->
            <field>
              <name>NPIE</name>
              <description>Switch to normal power supply interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BIE: Switch to battery supply interrupt enable-->
            <field>
              <name>BIE</name>
              <description>Switch to battery supply interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2IE: ALARM2 = TIME interrupt enable-->
            <field>
              <name>A2IE</name>
              <description>ALARM2 = TIME interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1IE: ALARM1 = TIME interrupt enable-->
            <field>
              <name>A1IE</name>
              <description>ALARM1 = TIME interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STATUS: Status register-->
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BU: Battery supply is used status-->
            <field>
              <name>BU</name>
              <description>Battery supply is used status</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <!--OSC_OK: RC oscillator state is ok-->
            <field>
              <name>OSC_OK</name>
              <description>RC oscillator state is ok</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--OF: Timer overflow was detected-->
            <field>
              <name>OF</name>
              <description>Timer overflow was detected</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPF: Switch to normal power supply was detected-->
            <field>
              <name>NPF</name>
              <description>Switch to normal power supply was detected</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BF: Switch to battery supply was detected-->
            <field>
              <name>BF</name>
              <description>Switch to battery supply was detected</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2F: ALARM2 = TIME front was detected-->
            <field>
              <name>A2F</name>
              <description>ALARM2 = TIME front was detected</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1F: ALARM1 = TIME front was detected-->
            <field>
              <name>A1F</name>
              <description>ALARM1 = TIME front was detected</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TRIM_RC: RC oscillator trim register-->
        <register>
          <name>TRIM_RC</name>
          <description>RC oscillator trim register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SIGN: -->
            <field>
              <name>SIGN</name>
              <description />
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TRIM_CLK1S: Clock 1s trim register-->
        <register>
          <name>TRIM_CLK1S</name>
          <description>Clock 1s trim register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SIGN: -->
            <field>
              <name>SIGN</name>
              <description />
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--GPR: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-15</dimIndex>
          <!--end of dimElementGroup-->
          <name>GPR[%s]</name>
          <description>GPR</description>
          <addressOffset>0x20</addressOffset>
          <register>
            <name />
            <description>General purpose register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: -->
              <field>
                <name>VAL</name>
                <description />
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <!--WDT-->
    <peripheral>
      <name>WDT</name>
      <version>1.0</version>
      <description>Watchdog timer</description>
      <groupName>WDT</groupName>
      <baseAddress>0x50006000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0xc04</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>WDT</name>
        <description>Watchdog timer interrupt</description>
        <value>1</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--LOAD: Watchdog Load Register-->
        <register>
          <name>LOAD</name>
          <description>Watchdog Load Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Begin value counter-->
            <field>
              <name>VAL</name>
              <description>Begin value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--VALUE: Watchdog Value Register-->
        <register>
          <name>VALUE</name>
          <description>Watchdog Value Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current value counter-->
            <field>
              <name>VAL</name>
              <description>Current value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Watchdog Control Register-->
        <register>
          <name>CTRL</name>
          <description>Watchdog Control Register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RESEN: Enable watchdog reset output-->
            <field>
              <name>RESEN</name>
              <description>Enable watchdog reset output</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--INTEN: Enable the interrupt event-->
            <field>
              <name>INTEN</name>
              <description>Enable the interrupt event</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--INTCLR: Watchdog Clear Interrupt Register-->
        <register>
          <name>INTCLR</name>
          <description>Watchdog Clear Interrupt Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTCLR: Reset interrupt WDT-->
            <field>
              <name>WDTCLR</name>
              <description>Reset interrupt WDT</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--RIS: Watchdog Raw Interrupt Status Register-->
        <register>
          <name>RIS</name>
          <description>Watchdog Raw Interrupt Status Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RAWWDTINT: Raw interrupt status from the counter-->
            <field>
              <name>RAWWDTINT</name>
              <description>Raw interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--MIS: Watchdog Interrupt Status Register-->
        <register>
          <name>MIS</name>
          <description>Watchdog Interrupt Status Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTINT: Enabled interrupt status from the counter-->
            <field>
              <name>WDTINT</name>
              <description>Enabled interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--LOCK: Watchdog Lock Register-->
        <register>
          <name>LOCK</name>
          <description>Watchdog Lock Register</description>
          <addressOffset>0xc00</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--REGWRDIS: Disable write to all registers Watchdog-->
            <field>
              <name>REGWRDIS</name>
              <description>Disable write to all registers Watchdog</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--I2C-->
    <peripheral>
      <name>I2C</name>
      <version>1.0</version>
      <description>I2C control registers</description>
      <groupName>I2C</groupName>
      <baseAddress>0x50007000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x48</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>I2C</name>
        <description>I2C interrupt</description>
        <value>58</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--SDA: Data register-->
        <register>
          <name>SDA</name>
          <description>Data register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DATA: Data field-->
            <field>
              <name>DATA</name>
              <description>Data field</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ST: Status register-->
        <register>
          <name>ST</name>
          <description>Status register</description>
          <addressOffset>0x4</addressOffset>
