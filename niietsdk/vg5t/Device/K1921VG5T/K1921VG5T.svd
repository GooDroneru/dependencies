              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKERR2: -->
            <field>
              <name>CLKERR2</name>
              <description />
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKERR1: -->
            <field>
              <name>CLKERR1</name>
              <description />
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKGOOD3: -->
            <field>
              <name>CLKGOOD3</name>
              <description />
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKGOOD2: -->
            <field>
              <name>CLKGOOD2</name>
              <description />
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKGOOD1: -->
            <field>
              <name>CLKGOOD1</name>
