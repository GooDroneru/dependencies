        <!--TZCTL: Trip-Zone Control Register-->
        <register>
          <name>TZCTL</name>
          <description>Trip-Zone Control Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TZB: When a trip event occurs the following action is taken on output B-->
            <field>
              <name>TZB</name>
              <description>When a trip event occurs the following action is taken on output B</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Z</name>
                  <description>PWMA/PWMB go to Z on failture</description>
