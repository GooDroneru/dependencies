            <!--CEVT1: Send DMA request when CEVT1-->
            <field>
              <name>CEVT1</name>
              <description>Send DMA request when CEVT1</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CEVT0: Send DMA request when CEVT0-->
            <field>
              <name>CEVT0</name>
              <description>Send DMA request when CEVT0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--FRC: Send DMA software request-->
            <field>
              <name>FRC</name>
              <description>Send DMA software request</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--DMARXREQ: DMA RX request mask register-->
        <register>
          <name>DMARXREQ</name>
          <description>DMA RX request mask register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CTRCMP: Send DMA request when CTR=CMP-->
            <field>
              <name>CTRCMP</name>
              <description>Send DMA request when CTR=CMP</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTRPRD: Send DMA request when CTR=PRD-->
            <field>
              <name>CTRPRD</name>
              <description>Send DMA request when CTR=PRD</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTROVF: Send DMA request when CTROVF-->
            <field>
              <name>CTROVF</name>
              <description>Send DMA request when CTROVF</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--CEVT3: Send DMA request when CEVT3-->
            <field>
              <name>CEVT3</name>
              <description>Send DMA request when CEVT3</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--CEVT2: Send DMA request when CEVT2-->
            <field>
              <name>CEVT2</name>
              <description>Send DMA request when CEVT2</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--CEVT1: Send DMA request when CEVT1-->
            <field>
              <name>CEVT1</name>
              <description>Send DMA request when CEVT1</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CEVT0: Send DMA request when CEVT0-->
            <field>
              <name>CEVT0</name>
              <description>Send DMA request when CEVT0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--FRC: Send DMA software request-->
            <field>
              <name>FRC</name>
              <description>Send DMA software request</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--CAP1-->
    <peripheral derivedFrom="CAP0">
      <name>CAP1</name>
      <baseAddress>0x5000A000</baseAddress>
      <interrupt>
        <name>CAP1</name>
        <description>Capture unit 1 interrupt</description>
        <value>40</value>
      </interrupt>
    </peripheral>
    <!--CAP2-->
    <peripheral derivedFrom="CAP0">
      <name>CAP2</name>
      <baseAddress>0x5000B000</baseAddress>
      <interrupt>
        <name>CAP2</name>
        <description>Capture unit 2 interrupt</description>
        <value>41</value>
      </interrupt>
    </peripheral>
    <!--PWM0-->
    <peripheral>
      <name>PWM0</name>
      <version>1.0</version>
      <description>PWM control registers</description>
      <groupName>PWM</groupName>
      <baseAddress>0x5000C000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x9c</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>PWM0</name>
        <description>PWM0 interrupt</description>
        <value>88</value>
      </interrupt>
      <interrupt>
        <name>PWM0_HD</name>
        <description>PWM0 HD interrupt</description>
        <value>89</value>
      </interrupt>
      <interrupt>
        <name>PWM0_TZ</name>
        <description>PWM0 TZ interrupt</description>
        <value>90</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--TBCTL: Time-Base Control Register-->
        <register>
          <name>TBCTL</name>
          <description>Time-Base Control Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x18000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SHDWGLOB: Global enabe for all shadow loads-->
            <field>
              <name>SHDWGLOB</name>
              <description>Global enabe for all shadow loads</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--FREESOFT: Emulation mode bits - select the behavior of the time-base counter during emulation events-->
            <field>
              <name>FREESOFT</name>
              <description>Emulation mode bits - select the behavior of the time-base counter during emulation events</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>StopAtTBCLK</name>
                  <description>stop timer at next TBCLK tact</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>StopAtPeriod</name>
                  <description>stop timer when period ends</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FreeRun</name>
                  <description>free run mode</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--PHSDIR: Phase direction bit-->
            <field>
              <name>PHSDIR</name>
              <description>Phase direction bit</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKDIV: Time-base clock prescale bits-->
            <field>
              <name>CLKDIV</name>
              <description>Time-base clock prescale bits</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Div1</name>
                  <description>clock not divided</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div2</name>
                  <description>clock divided by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div4</name>
                  <description>clock divided by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div8</name>
                  <description>clock divided by 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div16</name>
                  <description>clock divided by 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div32</name>
                  <description>clock divided by 32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div64</name>
                  <description>clock divided by 64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div128</name>
                  <description>clock divided by 128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--HSPCLKDIV: High speed time-base clock prescale bits-->
            <field>
              <name>HSPCLKDIV</name>
              <description>High speed time-base clock prescale bits</description>
              <bitRange>[9:7]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Div1</name>
                  <description>clock not divided</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div2</name>
                  <description>clock divided by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div4</name>
                  <description>clock divided by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div6</name>
                  <description>clock divided by 6</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div8</name>
                  <description>clock divided by 8</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div10</name>
                  <description>clock divided by 10</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div12</name>
                  <description>clock divided by 12</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Div14</name>
                  <description>clock divided by 14</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SWFSYNC: Software forced synchronization pulse-->
            <field>
              <name>SWFSYNC</name>
              <description>Software forced synchronization pulse</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--SYNCOSEL: Synchronization Output Select. These bits select the source of the PWM_SYNCO signal.-->
            <field>
              <name>SYNCOSEL</name>
              <description>Synchronization Output Select. These bits select the source of the PWM_SYNCO signal.</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYNCI</name>
                  <description>PWM_SYNCI is source for PWM_SYNCO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>CTR = 0000h is source for PWM_SYNCO</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqCMPB</name>
                  <description>CTR = CMPB is source for PWM_SYNCO</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>PWM_SYNCO generation disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--PRDLD: Active period register load from shadow register select-->
            <field>
              <name>PRDLD</name>
              <description>Active period register load from shadow register select</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--PHSEN: Counter register load from phase register enable-->
            <field>
              <name>PHSEN</name>
              <description>Counter register load from phase register enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTRMODE: Counter mode-->
            <field>
              <name>CTRMODE</name>
              <description>Counter mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Up</name>
                  <description>count direction up</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Down</name>
                  <description>count direction down</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UpDown</name>
                  <description>count direction up-down</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Stop</name>
                  <description>counter stopped</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--TBSTS: Time-Base Status Register-->
        <register>
          <name>TBSTS</name>
          <description>Time-Base Status Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CTRMAX: Time-Base counter max latched status bit-->
            <field>
              <name>CTRMAX</name>
              <description>Time-Base counter max latched status bit</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--SYNCI: Input synchronization latched status bit-->
            <field>
              <name>SYNCI</name>
              <description>Input synchronization latched status bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CTRDIR: Time-Base counter direction status bit-->
            <field>
              <name>CTRDIR</name>
              <description>Time-Base counter direction status bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--TBPHS: Time-Base Phase Register-->
        <register>
          <name>TBPHS</name>
          <description>Time-Base Phase Register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TBPHS: Time-base counter phase-->
            <field>
              <name>TBPHS</name>
              <description>Time-base counter phase</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TBPHSHR: Time-base counter phase in High-Resolution mode-->
            <field>
              <name>TBPHSHR</name>
              <description>Time-base counter phase in High-Resolution mode</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TBCTR: Time-Base Counter Register-->
        <register>
          <name>TBCTR</name>
          <description>Time-Base Counter Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current time-base counter value-->
            <field>
              <name>VAL</name>
              <description>Current time-base counter value</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TBPRD: Time-Base Period Register-->
        <register>
          <name>TBPRD</name>
          <description>Time-Base Period Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Period of the time-base counter-->
            <field>
              <name>VAL</name>
              <description>Period of the time-base counter</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CMPCTL: Counter-Compare Control Register-->
        <register>
          <name>CMPCTL</name>
          <description>Counter-Compare Control Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SHDWBFULL: CMPB shadow register full status flag-->
            <field>
              <name>SHDWBFULL</name>
              <description>CMPB shadow register full status flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <!--SHDWAFULL: CMPA shadow register full status flag-->
            <field>
              <name>SHDWAFULL</name>
              <description>CMPA shadow register full status flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--SHDWBMODE: CMPB register operating mode-->
            <field>
              <name>SHDWBMODE</name>
              <description>CMPB register operating mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--SHDWAMODE: CMPA register operating mode-->
            <field>
              <name>SHDWAMODE</name>
              <description>CMPA register operating mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--LOADBMODE: Active CMPB load from shadow select mode-->
            <field>
              <name>LOADBMODE</name>
              <description>Active CMPB load from shadow select mode</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = PRD</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZeroPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0 or CTR = PRD</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>shadow load for CMPx (x=A,B) disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LOADAMODE: Active CMPA load from shadow select mode-->
            <field>
              <name>LOADAMODE</name>
              <description>Active CMPA load from shadow select mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CTREqZero</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = PRD</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CTREqZeroPRD</name>
                  <description>shadow load for CMPx (x=A,B) when CTR = 0 or CTR = PRD</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>shadow load for CMPx (x=A,B) disabled</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--CMPA: Counter-Compare A Register-->
        <register>
          <name>CMPA</name>
          <description>Counter-Compare A Register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMPA: The value compared to the time-base counter (TBCTR)-->
            <field>
              <name>CMPA</name>
              <description>The value compared to the time-base counter (TBCTR)</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--CMPAHR: The value compared to the time-base counter (TBCTR) in High-Resolution mode-->
            <field>
              <name>CMPAHR</name>
              <description>The value compared to the time-base counter (TBCTR) in High-Resolution mode</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CMPB: Counter-Compare B Register-->
        <register>
          <name>CMPB</name>
          <description>Counter-Compare B Register</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CMPB: The value compared to the time-base counter (TBCTR)-->
            <field>
              <name>CMPB</name>
              <description>The value compared to the time-base counter (TBCTR)</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--AQCTLA: Action-Qualifier Output A Control Register-->
        <register>
          <name>AQCTLA</name>
          <description>Action-Qualifier Output A Control Register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CBD: Action when the time-base counter equals the active CMPB register and the counter is decrementing-->
            <field>
              <name>CBD</name>
              <description>Action when the time-base counter equals the active CMPB register and the counter is decrementing</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoAction</name>
                  <description>no action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>clear PWMA/PWMB</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>set PWMA/PWMB</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>inverse PWMA/PWMB</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CBU: Action when the counter equals the active CMPB register and the counter is incrementing-->
            <field>
              <name>CBU</name>
              <description>Action when the counter equals the active CMPB register and the counter is incrementing</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoAction</name>
                  <description>no action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>clear PWMA/PWMB</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>set PWMA/PWMB</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>inverse PWMA/PWMB</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CAD: Action when the counter equals the active CMPA register and the counter is decrementing-->
            <field>
              <name>CAD</name>
              <description>Action when the counter equals the active CMPA register and the counter is decrementing</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NoAction</name>
                  <description>no action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>clear PWMA/PWMB</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Set</name>
                  <description>set PWMA/PWMB</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
