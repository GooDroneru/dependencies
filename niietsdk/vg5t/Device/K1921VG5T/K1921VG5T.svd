        </cluster>
        <!--DC: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>12</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>DC[%s]</name>
          <description>DC</description>
          <addressOffset>0x400</addressOffset>
          <register>
            <name>DCTL</name>
            <description>Digital comparator control register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--HWTCLR: Hardware output trigger clear-->
              <field>
                <name>HWTCLR</name>
                <description>Hardware output trigger clear</description>
                <bitRange>[28:28]</bitRange>
                <access>read-write</access>
              </field>
              <!--SRC: Select data source for comparation: ADC module (0) or sequencer(1)-->
              <field>
                <name>SRC</name>
                <description>Select data source for comparation: ADC module (0) or sequencer(1)</description>
                <bitRange>[24:24]</bitRange>
                <access>read-write</access>
              </field>
              <!--CHNL: ADC channel selection-->
              <field>
                <name>CHNL</name>
                <description>ADC channel selection</description>
                <bitRange>[18:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--CTE: Enable DC output trigger-->
              <field>
                <name>CTE</name>
                <description>Enable DC output trigger</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--CTC: DC output trigger compare conditions-->
              <field>
                <name>CTC</name>
                <description>DC output trigger compare conditions</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Low</name>
                    <description>result lower or equal COMP0</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Window</name>
                    <description>result between COMP0 and COMP1 or equal any of them</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>High</name>
                    <description>result higher or equal COMP1</description>
                    <value>2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--CTM: DC output trigger mode-->
              <field>
                <name>CTM</name>
                <description>DC output trigger mode</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Multiple</name>
                    <description>multiple trigger mode</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Single</name>
                    <description>single trigger mode</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MultipleHyst</name>
                    <description>multiple trigger mode with hysteresis</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SingleHyst</name>
                    <description>single trigger mode with hysteresis</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--CIE: Enable DC interrupt generation-->
              <field>
                <name>CIE</name>
                <description>Enable DC interrupt generation</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--CIC: DC interrupt generation compare conditions-->
              <field>
                <name>CIC</name>
                <description>DC interrupt generation compare conditions</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Low</name>
                    <description>result lower or equal COMP0</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Window</name>
                    <description>result between COMP0 and COMP1 or equal any of them</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>High</name>
                    <description>result higher or equal COMP1</description>
                    <value>2</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--CIM: DC interrupt generation mode-->
              <field>
                <name>CIM</name>
                <description>DC interrupt generation mode</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <usage>read-write</usage>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>Multiple</name>
                    <description>multiple trigger mode</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>Single</name>
                    <description>single trigger mode</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MultipleHyst</name>
                    <description>multiple trigger mode with hysteresis</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SingleHyst</name>
                    <description>single trigger mode with hysteresis</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DCMP</name>
            <description>Digital comparator range register</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
