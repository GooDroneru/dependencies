              </enumeratedValues>
            </field>
            <!--SCR: Value divider-->
            <field>
              <name>SCR</name>
              <description>Value divider</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--DSS: Size of data is (value + 1) bits-->
            <field>
              <name>DSS</name>
              <description>Size of data is (value + 1) bits</description>
              <bitRange>[4:0]</bitRange>
