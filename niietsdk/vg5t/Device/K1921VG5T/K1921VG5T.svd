              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <!--SPO: Polarity SSPCLKOUT-->
            <field>
              <name>SPO</name>
              <description>Polarity SSPCLKOUT</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--FRF: Select protocol-->
            <field>
              <name>FRF</name>
              <description>Select protocol</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SPI</name>
