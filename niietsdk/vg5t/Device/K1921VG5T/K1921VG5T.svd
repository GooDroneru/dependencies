                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DST_PTR</name>
            <description>Command register 1 (destination pointer)</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--WR_ADDR: Start address of write buffer-->
