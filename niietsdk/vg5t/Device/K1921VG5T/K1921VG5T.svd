        </register>
        <!--DR: Data register-->
        <register>
          <name>DR</name>
          <description>Data register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DATA: -->
            <field>
              <name>DATA</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--SR: State register-->
        <register>
          <name>SR</name>
          <description>State register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x3</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BSY: Activity flag-->
            <field>
              <name>BSY</name>
              <description>Activity flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--RFF: Indicate full receive buffer-->
            <field>
              <name>RFF</name>
              <description>Indicate full receive buffer</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--RNE: Indicate not empty receive buffer-->
            <field>
              <name>RNE</name>
              <description>Indicate not empty receive buffer</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--TNF: Indicator the transmitter FIFO buffer is not full-->
            <field>
              <name>TNF</name>
              <description>Indicator the transmitter FIFO buffer is not full</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--TFE: FIFO buffer empty flag transmitter-->
            <field>
              <name>TFE</name>
              <description>FIFO buffer empty flag transmitter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CPSR: Clock division factor register-->
        <register>
          <name>CPSR</name>
          <description>Clock division factor register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CPSDVSR: Clock division factor. Bit0 always 0-->
            <field>
              <name>CPSDVSR</name>
              <description>Clock division factor. Bit0 always 0</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--IMSC: Mask interrupt register-->
        <register>
          <name>IMSC</name>
          <description>Mask interrupt register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TXIM: SSPTXINTR interrupt mask bit to fill 50% or less of the FIFO buffer of the transmitter-->
            <field>
              <name>TXIM</name>
              <description>SSPTXINTR interrupt mask bit to fill 50% or less of the FIFO buffer of the transmitter</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--RXIM: SSPRXINTR interrupt mask bit to fill 50% or less of the receiver FIFO buffer-->
            <field>
              <name>RXIM</name>
              <description>SSPRXINTR interrupt mask bit to fill 50% or less of the receiver FIFO buffer</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--RTIM: Interrupt mask bit SSPRTINTR timeout receiver-->
            <field>
              <name>RTIM</name>
              <description>Interrupt mask bit SSPRTINTR timeout receiver</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RORIM: Interrupt mask bit SSPRORINTR buffer overflow receiver-->
            <field>
              <name>RORIM</name>
              <description>Interrupt mask bit SSPRORINTR buffer overflow receiver</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RIS: Status register interrupt without mask-->
        <register>
          <name>RIS</name>
          <description>Status register interrupt without mask</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TXRIS: Interrupt status before masking SSPTXINTR-->
            <field>
              <name>TXRIS</name>
              <description>Interrupt status before masking SSPTXINTR</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--RXRIS: Interrupt status before masking SSPRXINTR-->
            <field>
              <name>RXRIS</name>
              <description>Interrupt status before masking SSPRXINTR</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--RTRIS: Interrupt status before masking SSPRTINTR-->
            <field>
              <name>RTRIS</name>
              <description>Interrupt status before masking SSPRTINTR</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--RORRIS: Interrupt status before masking SSPRORINTR-->
            <field>
              <name>RORRIS</name>
              <description>Interrupt status before masking SSPRORINTR</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--MIS: Status register interrupt masking account-->
        <register>
          <name>MIS</name>
          <description>Status register interrupt masking account</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TXMIS: Masked interrupt status SSPTXINTR-->
            <field>
              <name>TXMIS</name>
              <description>Masked interrupt status SSPTXINTR</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--RXMIS: Masked interrupt status SSPRXINTR-->
            <field>
              <name>RXMIS</name>
              <description>Masked interrupt status SSPRXINTR</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--RTMIS: Masked interrupt status SSPRTINTR-->
            <field>
              <name>RTMIS</name>
              <description>Masked interrupt status SSPRTINTR</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--RORMIS: Masked interrupt status SSPRORINTR-->
            <field>
              <name>RORMIS</name>
              <description>Masked interrupt status SSPRORINTR</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--ICR: Register reset interrupt-->
        <register>
          <name>ICR</name>
          <description>Register reset interrupt</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RTIC: Reset interrupt SSPRTINTR-->
            <field>
              <name>RTIC</name>
              <description>Reset interrupt SSPRTINTR</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <!--RORIC: Reset interrupt SSPRORINTR-->
            <field>
              <name>RORIC</name>
              <description>Reset interrupt SSPRORINTR</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--DMACR: Control register DMA-->
        <register>
          <name>DMACR</name>
          <description>Control register DMA</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DMATXSTOP: Automatic clear DMA TX request generation when channel ends all transactions-->
            <field>
              <name>DMATXSTOP</name>
              <description>Automatic clear DMA TX request generation when channel ends all transactions</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--DMARXSTOP: Automatic clear DMA RX request generation when channel ends all transactions-->
            <field>
              <name>DMARXSTOP</name>
              <description>Automatic clear DMA RX request generation when channel ends all transactions</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--TXDMAE: DMA enable bit transmission-->
            <field>
              <name>TXDMAE</name>
              <description>DMA enable bit transmission</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RXDMAE: DMA enable bit at reception-->
            <field>
              <name>RXDMAE</name>
              <description>DMA enable bit at reception</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--SPI1-->
    <peripheral derivedFrom="SPI0">
      <name>SPI1</name>
      <baseAddress>0x50010000</baseAddress>
      <interrupt>
        <name>SPI1</name>
        <description>SPI1 interrupt</description>
        <value>71</value>
      </interrupt>
      <interrupt>
        <name>SPI1_RX</name>
        <description>SPI1 Receive interrupt</description>
        <value>72</value>
      </interrupt>
      <interrupt>
        <name>SPI1_TX</name>
        <description>SPI1 Transmit interrupt</description>
        <value>73</value>
      </interrupt>
      <interrupt>
        <name>SPI1_RO</name>
        <description>SPI1 Receive Overrun interrupt</description>
        <value>74</value>
      </interrupt>
      <interrupt>
        <name>SPI1_RT</name>
        <description>SPI1 Receive Timeout interrupt</description>
        <value>75</value>
      </interrupt>
    </peripheral>
    <!--TMR0-->
    <peripheral>
      <name>TMR0</name>
      <version>1.0</version>
      <description>Timer 32-bit control registers</description>
      <groupName>TMR</groupName>
      <baseAddress>0x50011000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x118</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>TMR0</name>
        <description>Timer 0 combine interrupt</description>
        <value>42</value>
      </interrupt>
      <interrupt>
        <name>TMR0_PERIOD</name>
        <description>Timer 0 period interrupt</description>
        <value>43</value>
      </interrupt>
      <interrupt>
        <name>TMR0_CC0</name>
        <description>Timer 0 CAPCOM 0 interrupt</description>
        <value>44</value>
      </interrupt>
      <interrupt>
        <name>TMR0_CC1</name>
        <description>Timer 0 CAPCOM 1 interrupt</description>
        <value>45</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CTRL: Timer control register-->
        <register>
          <name>CTRL</name>
          <description>Timer control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OUTEN: CAPCOM0 block output enable-->
            <field>
              <name>OUTEN</name>
              <description>CAPCOM0 block output enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKSEL: Clock Source Select-->
            <field>
              <name>CLKSEL</name>
              <description>Clock Source Select</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SysClk</name>
                  <description>Select system Clk</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ExtClk</name>
                  <description>Select External Clk</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DMARXSTOP: Stop Timer when RX DMA channel ends all transactions-->
            <field>
              <name>DMARXSTOP</name>
              <description>Stop Timer when RX DMA channel ends all transactions</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--DMATXSTOP: Stop Timer when TX DMA channel ends all transactions-->
            <field>
              <name>DMATXSTOP</name>
              <description>Stop Timer when TX DMA channel ends all transactions</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--MODE: Count mode-->
            <field>
              <name>MODE</name>
              <description>Count mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop</name>
                  <description>Timer is Stopped</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Up</name>
                  <description>Timer count Up</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Multiple</name>
                  <description>Timer count is multiple Up</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UpDown</name>
                  <description>Timer count is multiple Up - Down</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CLR: Timer Clear-->
            <field>
              <name>CLR</name>
              <description>Timer Clear</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <!--FREESOFT: Emulation mode bits - select the behavior of the time-base counter during emulation events-->
            <field>
              <name>FREESOFT</name>
              <description>Emulation mode bits - select the behavior of the time-base counter during emulation events</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>StopAtCLK</name>
                  <description>stop timer at next CLK tact</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>StopAtOverload</name>
                  <description>stop timer when overload</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NoStop</name>
                  <description>endless count</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--COUNT: Current value timer register-->
        <register>
          <name>COUNT</name>
          <description>Current value timer register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current timer value-->
            <field>
              <name>VAL</name>
              <description>Current timer value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CLKDIV: Clock divider register-->
        <register>
          <name>CLKDIV</name>
          <description>Clock divider register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PERIOD: Timer period register-->
        <register>
          <name>PERIOD</name>
          <description>Timer period register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
