                <description>Value of last compared AD conversion result</description>
                <bitRange>[11:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--ACTL: ADC module control register-->
        <register>
          <name>ACTL</name>
