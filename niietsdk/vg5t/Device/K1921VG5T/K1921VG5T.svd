    <!--RCU-->
    <peripheral>
      <name>RCU</name>
      <version>1.0</version>
      <description>Reset and clock unit</description>
      <groupName>RCU</groupName>
      <baseAddress>0x50004000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0xc8</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>RCU</name>
        <description>Reset Clock unit interrupt</description>
        <value>2</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CGCFGAHB: Clockgate AHB configuration register-->
        <register>
          <name>CGCFGAHB</name>
          <description>Clockgate AHB configuration register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ADCEN: Enable clock ADC-->
            <field>
              <name>ADCEN</name>
              <description>Enable clock ADC</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--CANEN: Enable clock CAN-->
            <field>
              <name>CANEN</name>
              <description>Enable clock CAN</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--GPIOBEN: Enable clock GPIOB-->
            <field>
              <name>GPIOBEN</name>
